<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Navy window so splash→WebView never flashes Material white / bright blue status. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FF1B2A4A</item>
        <item name="android:colorBackground">#FF1B2A4A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
