let mem = null; // { at, payload }
let inflight = null;

function readDisk() {
  try {
    return JSON.parse(fs.readFileSync(CACHE_FILE(), 'utf8'));
  } catch {
    return null;
  }
}
function writeDisk(obj) {
  try {
    fs.mkdirSync(CACHE_DIR(), { recursive: true });
    const tmp = CACHE_FILE() + '.tmp';
    fs.writeFileSync(tmp, JSON.stringify(obj));
    fs.renameSync(tmp, CACHE_FILE());
  } catch (e) {
    console.warn('news cache write failed', e.message);
  }
}

function stripHtml(s) {
  return String(s || '')
    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/gi, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
    .replace(/\s+/g, ' ')
    .trim();
}

function tagText(block, tag) {
  const re = new RegExp(
    `<${tag}(?:\\s[^>]*)?>(?:<!\\[CDATA\\[([\\s\\S]*?)\\]\\]>|([\\s\\S]*?))</${tag}>`,
    'i'
  );
  const m = block.match(re);
  if (!m) return '';
  return stripHtml(m[1] != null && m[1] !== undefined ? m[1] : m[2] || '');
}

function attrIn(block, re) {
  const m = block.match(re);
  return m ? String(m[1] || '').trim() : '';
}

function parsePubDate(s) {
  if (!s) return null;
  const t = Date.parse(s);
  return Number.isNaN(t) ? null : new Date(t).toISOString();
}

function itemId(link) {
  return crypto.createHash('sha256').update(String(link || '')).digest('hex').slice(0, 16);
}

function parseRss(xml, source) {
  const items = [];
  const chunks = String(xml || '').match(/<item[\s\S]*?<\/item>/gi) || [];
  // Atom fallback
  const entries = chunks.length ? chunks : (String(xml || '').match(/<entry[\s\S]*?<\/entry>/gi) || []);
  for (const block of entries) {
    let title = tagText(block, 'title');
    let link = tagText(block, 'link');
    if (!link) {
      link = attrIn(block, /<link[^>]+href=["']([^"']+)["']/i);
    }
    if (!link) {
      const guid = tagText(block, 'guid');
      if (/^https?:\/\//i.test(guid)) link = guid;
    }
    if (!title || !link || !/^https?:\/\//i.test(link)) continue;
    // Drop tracking junk on BBC etc.
    try {
      const u = new URL(link);
      u.searchParams.delete('at_medium');
      u.searchParams.delete('at_campaign');
      link = u.toString();
    } catch { /* keep */ }

    let summary = tagText(block, 'description') || tagText(block, 'summary') || tagText(block, 'content:encoded') || tagText(block, 'content');
    if (summary.length > 480) summary = summary.slice(0, 477) + '…';

    let thumb =
      attrIn(block, /<media:thumbnail[^>]+url=["']([^"']+)["']/i) ||
      attrIn(block, /<media:content[^>]+url=["']([^"']+)["'][^>]*(?:medium=["']image["']|type=["']image)/i) ||
      attrIn(block, /<enclosure[^>]+(?:type=["']image[^"']*["'][^>]+url=["']([^"']+)["']|url=["']([^"']+)["'][^>]+type=["']image)/i) ||
      attrIn(block, /<enclosure[^>]+url=["']([^"']+\.(?:jpe?g|png|webp|gif)[^"']*)["']/i) ||
      '';
    if (!thumb) {
      const img = block.match(/<img[^>]+src=["']([^"']+)["']/i);
      if (img) thumb = img[1];
    }
    if (thumb && thumb.startsWith('//')) thumb = 'https:' + thumb;

    const publishedAt = parsePubDate(tagText(block, 'pubDate') || tagText(block, 'published') || tagText(block, 'updated') || attrIn(block, /<dc:date[^>]*>([^<]+)</i));

    items.push({
      id: itemId(link),
      title,
      summary,
      link,
      thumb: thumb || '',
      source: source.name,
      sourceId: source.id,
      sourceZh: source.nameZh,
      publishedAt,
    });
  }
  return items;
}

async function fetchText(url) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT_MS);
  try {
    const r = await fetch(url, {
      headers: {
        'User-Agent': 'Mozilla/5.0 (compatible; JingcaiNews/1.3; +https://tiicai.local)',
        Accept: 'application/rss+xml, application/atom+xml, application/xml, text/xml, */*;q=0.8',
        'Accept-Language': 'en-US,en;q=0.9,zh-CN;q=0.8',
      },
      signal: ctrl.signal,
      redirect: 'follow',
    });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    const text = await r.text();
    if (!text || text.length < 64) throw new Error('empty body');
    if (/^\s*<!DOCTYPE html/i.test(text) || /^\s*<html/i.test(text)) throw new Error('HTML not RSS');
    return text;
  } finally {
    clearTimeout(t);
  }
}

function mergeBySource(prevItems, freshBySource, now) {
  const bySource = {};
  for (const it of prevItems || []) {
    if (!bySource[it.sourceId]) bySource[it.sourceId] = [];
    bySource[it.sourceId].push(it);
  }
  for (const [sid, items] of Object.entries(freshBySource)) {
    bySource[sid] = items.map((x) => ({ ...x, _fetchedAt: now }));
  }
  const out = [];
  const seen = new Set();
  for (const list of Object.values(bySource)) {
    for (const it of list) {
      if (seen.has(it.id)) continue;
      // drop very old stale
      const fetched = it._fetchedAt || (it.publishedAt ? Date.parse(it.publishedAt) : now);
      if (now - fetched > STALE_MAX_MS && !freshBySource[it.sourceId]) continue;
      seen.add(it.id);
      const { _fetchedAt, ...clean } = it;
      out.push(clean);
    }
  }
  out.sort((a, b) => {
    const ta = a.publishedAt ? Date.parse(a.publishedAt) : 0;
    const tb = b.publishedAt ? Date.parse(b.publishedAt) : 0;
    return tb - ta;
  });
  return out;
}

async function refresh() {
  const prev = (mem && mem.payload) || readDisk() || { items: [], sources: [], errors: [] };
  const freshBySource = {};
  const errors = [];
  const sourceStatus = [];

  await Promise.all(
    SOURCES.map(async (src) => {
      try {
        const xml = await fetchText(src.url);
        const items = parseRss(xml, src);
        if (!items.length) throw new Error('no items parsed');
        freshBySource[src.id] = items.slice(0, 40);
        sourceStatus.push({ id: src.id, name: src.nameZh, ok: true, count: items.length });
      } catch (e) {
        errors.push(`${src.id}: ${e.message}`);
        sourceStatus.push({ id: src.id, name: src.nameZh, ok: false, error: e.message });
      }
    })
  );

  const now = Date.now();
  const items = mergeBySource(prev.items, freshBySource, now);
  const payload = {
    source: Object.keys(freshBySource).length ? 'live' : prev.items && prev.items.length ? 'cache' : 'empty',
    fetchedAt: new Date().toISOString(),
    cacheTtlSec: Math.round(CACHE_TTL_MS / 1000),
    sources: sourceStatus,
    errors: errors.length ? errors : undefined,
    noteZh: '资讯来自公开 RSS，仅作摘要展示并注明出处；点击原文跳转来源站点。不构成投注建议。',
    items,
  };
  mem = { at: Date.now(), payload };
  writeDisk(payload);
  return payload;
}

async function getNews({ force } = {}) {
  if (!force && mem && Date.now() - mem.at < CACHE_TTL_MS) return mem.payload;
  if (!force && !mem) {
    const disk = readDisk();
    if (disk && disk.fetchedAt && Date.now() - Date.parse(disk.fetchedAt) < CACHE_TTL_MS) {
      mem = { at: Date.parse(disk.fetchedAt) || Date.now(), payload: disk };
      return disk;
    }
    if (disk && disk.items && disk.items.length) {
      // serve stale immediately, refresh in background
      mem = { at: Date.now() - CACHE_TTL_MS + 5000, payload: disk };
    }
  }
  if (inflight) return inflight;
  inflight = refresh()
    .catch((e) => {
      const disk = readDisk();
      if (disk && disk.items && disk.items.length) {
        const payload = { ...disk, source: 'cache', noteZh: (disk.noteZh || '') + '（刷新失败，显示缓存）', errors: [e.message] };
        mem = { at: Date.now(), payload };
        return payload;
      }
      throw e;
    })
    .finally(() => {
      inflight = null;
    });
  return inflight;
}

function expandQuery(q) {
  const raw = String(q || '').trim();
  if (!raw) return [];
  const terms = new Set([raw]);
  // split multi-team "主队 客队" style
  for (const part of raw.split(/[\s,，/|]+/).filter(Boolean)) {
    terms.add(part);
    const mapped = ZH_TEAM[part];
    if (mapped) mapped.forEach((t) => terms.add(t));
    // partial zh key match
    for (const [zh, ens] of Object.entries(ZH_TEAM)) {
      if (part.includes(zh) || zh.includes(part)) ens.forEach((t) => terms.add(t));
    }
  }
  // Only add crest English names that exactly match an expanded term (avoid Man City → Man Utd via "Manchester").
  try {
    const crests = JSON.parse(fs.readFileSync(path.join(__dirname, '..', 'data', 'crests.json'), 'utf8'));
    const lowerTerms = new Set([...terms].map((x) => String(x).toLowerCase()));
    for (const row of Object.values((crests && crests.teams) || {})) {
      const en = row && row.en;
      if (!en) continue;
      const el = en.toLowerCase();
      if (lowerTerms.has(el)) terms.add(en);
    }
  } catch { /* optional */ }
  return [...terms].filter(Boolean);
}

function filterItems(items, q) {
  const terms = expandQuery(q);
  if (!terms.length) return items;
  const lower = terms.map((t) => String(t).toLowerCase());
  return items.filter((it) => {
    const hay = (it.title + ' ' + (it.summary || '')).toLowerCase();
    return lower.some((t) => t.length >= 2 && hay.includes(t));
  });
}

function listNews(opts = {}) {
  return getNews({ force: !!opts.force }).then((payload) => {
    let items = payload.items || [];
    if (opts.q) items = filterItems(items, opts.q);
    const limit = Math.min(Math.max(parseInt(opts.limit, 10) || 50, 1), 100);
    return {
      ...payload,
      q: opts.q || undefined,
      total: items.length,
      items: items.slice(0, limit).map((it) => ({
        id: it.id,
        title: it.title,
        summary: it.summary,
        link: it.link,
        thumb: it.thumb,
        source: it.source,
        sourceZh: it.sourceZh,
        sourceId: it.sourceId,
        publishedAt: it.publishedAt,
      })),
    };
  });
}

function getNewsItem(idOrHash) {
  const key = String(idOrHash || '').trim();
  if (!key) return Promise.resolve(null);
  return getNews().then((payload) => {
    const items = payload.items || [];
    let hit = items.find((x) => x.id === key);
    if (!hit && /^https?:\/\//i.test(key)) {
      const id = itemId(key);
      hit = items.find((x) => x.id === id || x.link === key);
    }
    if (!hit) {
      // try hash prefix
      hit = items.find((x) => x.id.startsWith(key) || key.startsWith(x.id));
    }
    if (!hit) return null;
    return {
      source: payload.source,
      fetchedAt: payload.fetchedAt,
      noteZh: payload.noteZh,
      item: hit,
    };
  });
}

module.exports = {
  listNews,
  getNewsItem,
  getNews,
  refresh,
  SOURCES,
  CACHE_TTL_MS,
  itemId,
  parseRss,
  expandQuery,
};
