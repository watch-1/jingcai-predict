// Free public football RSS aggregator. Prefer sources reachable from mainland China;
// disk-cache aggressively so unreachable feeds still serve last good items.
'use strict';
const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const { DATA_DIR } = require('./db');

const CACHE_TTL_MS = 20 * 60 * 1000; // 20 min
const STALE_MAX_MS = 6 * 60 * 60 * 1000; // keep per-source items up to 6h if refresh fails
const FETCH_TIMEOUT_MS = 10000;
const CACHE_DIR = () => path.join(DATA_DIR, 'news');
const CACHE_FILE = () => path.join(CACHE_DIR(), 'cache.json');

// Prefer feeds known to work from CN servers first (Sky). ESPN/BBC often blocked in CN
// but succeed from overseas (box) — seed cache on deploy when needed.
const SOURCES = [
  {
    id: 'sky',
    name: 'Sky Sports',
    nameZh: '天空体育',
    url: 'https://www.skysports.com/rss/12040',
  },
  {
    id: 'espn',
    name: 'ESPN FC',
    nameZh: 'ESPN足球',
    url: 'https://www.espn.com/espn/rss/soccer/news',
  },
  {
    id: 'bbc',
    name: 'BBC Sport',
    nameZh: 'BBC体育',
    url: 'https://feeds.bbci.co.uk/sport/football/rss.xml',
  },
  {
    id: 'guardian',
    name: 'The Guardian',
    nameZh: '卫报足球',
    url: 'https://www.theguardian.com/football/rss',
  },
];

